rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global ORAR collection: all orar clones are stored here, keyed by hash
    match /orares/{hash} {
      allow read: if true;
      allow write: if true;
    }

    // User settings & custom orares subcollections: each user stores settings and custom orares
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
